# Copie para .env e ajuste. Nunca envie o .env para o Git.

# Banco de dados (no Docker Compose, o host é "db")
DATABASE_URL=postgres://fight:fight@localhost:5432/fight_manager

# Banco usado pelos testes automatizados (é apagado e recriado a cada execução)
TEST_DATABASE_URL=postgres://fight:fight@localhost:5432/fight_manager_test

# Banco dos testes de ponta a ponta (npm run test:e2e): também é apagado e recriado
E2E_DATABASE_URL=postgres://fight:fight@localhost:5432/fight_manager_e2e

# Senha do PostgreSQL usada pelo docker-compose.yml
POSTGRES_PASSWORD=fight

# Fuso horário usado para calcular atrasos e datas
APP_TIMEZONE=America/Sao_Paulo

# ---------------------------------------------------------------- e-mail (guia: docs/instalacao.md)
# Usado para: link de acesso de academias novas, recuperação de senha e convites por e-mail.
# Sem nada configurado, os e-mails só aparecem no console do servidor.
# Teste a configuração com: npm run email:test -- seu@email.com
#
# Forma de envio: resend, smtp ou console. Se ficar vazio, é escolhida pelo que estiver preenchido abaixo.
# EMAIL_PROVIDER=smtp
# Remetente que aparece para quem recebe (precisa ser de um domínio/conta autorizado no serviço)
# EMAIL_FROM=Fight Manager <nao-responda@seudominio.com.br>
#
# Opção 1: Resend (https://resend.com), com o domínio verificado
# RESEND_API_KEY=re_...
#
# Opção 2: SMTP (Gmail, Outlook, Hostinger, Locaweb, Brevo, Amazon SES, e-mail do seu domínio...)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# true só na porta 465 (SSL); na 587 fica false (STARTTLS)
# SMTP_SECURE=false
# SMTP_USER=seu@gmail.com
# no Gmail e no Outlook, use uma "senha de app", não a senha normal da conta
# SMTP_PASS=senha-de-app
#
# Opcional em desenvolvimento: grava cada e-mail como arquivo nesta pasta
# EMAIL_OUTBOX_DIR=.outbox

# ---------------------------------------------------------------- contas de teste
# Mostra as contas de teste do seed na tela de login (true/false).
# Sem a variável: aparecem só em desenvolvimento (npm run dev).
# SHOW_TEST_ACCOUNTS=true

# Cookie de sessão só por HTTPS (padrão: true em produção). Use false só para testar
# o build de produção em rede local sem HTTPS. Nunca desligue em um servidor público.
# COOKIE_SECURE=false

# Aviso de erros do servidor por webhook (opcional): Discord, Slack, ntfy...
ERROR_WEBHOOK_URL=
# Quantos dias de backup guardar (serviço "backup" do docker compose)
BACKUP_KEEP_DAYS=14

# Tarefa diária (mensalidades automáticas e lembretes por e-mail). Use um valor longo e aleatório em produção.
CRON_SECRET=troque-este-segredo-local
# Endereço público do sistema (links dos e-mails enviados pela tarefa diária)
APP_URL=http://localhost:3000
